name: Build Android APK
on:
  push:
    branches: [ main ]
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Ver que hay en el repo
        run: |
          echo "--- TODOS LOS ARCHIVOS ---"
          find . -type f | sort
          echo "--- BUSCANDO CSPROJ ---"
          ls -R
      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '9.0.x'
      - name: Install MAUI
        run: dotnet workload install maui-android
      - name: Restore
        run: |
          CSPROJ=$(find . -name "*.csproj" | head -n 1)
          echo "Usando: $CSPROJ"
          if [ -z "$CSPROJ" ]; then echo "NO HAY NINGUN CSPROJ EN EL REPO - CREALO EN ExploradorV2/ExploradorV2.csproj"; exit 1; fi
          dotnet restore "$CSPROJ"
          echo "CSPROJ=$CSPROJ" >> $GITHUB_ENV
      - name: Build APK
        run: dotnet publish "$CSPROJ" -c Release -f net9.0-android -p:AndroidPackageFormat=apk -o output
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: ExploradorV2-APK
          path: output/*.apk
